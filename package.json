{
  "name": "@naveedinno/codestory",
  "version": "0.1.0",
  "description": "codeStory — guided, in-order diff review with a local queued-comment handoff.",
  "type": "module",
  "author": "naveedinno <naveedinno@proton.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naveedinno/codeStory.git"
  },
  "homepage": "https://github.com/naveedinno/codeStory#readme",
  "bugs": "https://github.com/naveedinno/codeStory/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "assets/brand",
    "assets/demo",
    "skills",
    "README.md"
  ],
  "scripts": {
    "prototype:story-map": "npm run build && node scripts/story-map-prototype.mjs",
    "prepare": "npm run build",
    "build": "tsc && npm run build:browser-assets && npm run build:client && npm run build:skill-checker",
    "build:browser-assets": "node scripts/build-browser-assets.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:skill-checker": "node scripts/build-skill-checker.mjs",
    "typecheck:client": "tsc -p client/tsconfig.json",
    "check": "npm run build && npm run typecheck:client && node --test test/*.test.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:caller-helper": "npm run build && node scripts/caller-helper-smoke.mjs",
    "test:video": "npm run build && node scripts/video-smoke.mjs",
    "dev": "npm run build && node dist/app-server.js",
    "start": "node dist/app-server.js",
    "demo": "npm run build && node examples/demo.mjs",
    "ui:atlas": "npm run build && node scripts/capture-ui-atlas.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "release:check": "npm run check && npm pack --dry-run --json",
    "prepublishOnly": "npm run check",
    "eval:stories": "npm run build && node scripts/eval-stories.mjs",
    "check:zed": "node --test test/zed-mcp-server.test.mjs && cargo test --manifest-path zed-extension/Cargo.toml && cargo check --manifest-path zed-extension/Cargo.toml --target wasm32-wasip2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codestory",
    "code-review",
    "diff",
    "ai",
    "agent",
    "guided-review",
    "claude-code"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "mermaid": "^11.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "motion": "^11.18.2",
    "playwright-core": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}
